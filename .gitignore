build
dist
storybook-static

# misc
.DS_Store
.env
npm-debug.log
tmp

.claude/
.codex/
.agents/

# Brainstorming visual companion artifacts
.superpowers/

# Playwright (Examples/Showcase/Tests)
# Filesystem is case-insensitive on macOS, so the plan's `tests/` resolves
# to the existing `Tests/` directory that already hosts Swift unit tests.
Examples/Showcase/Tests/node_modules/
Examples/Showcase/Tests/test-results/
Examples/Showcase/Tests/playwright-report/
Examples/Showcase/Tests/blob-report/

# Generated previews — committed only when a chapter opts into .screenshot
Examples/Showcase/Resources/snapshots/*.png
!Examples/Showcase/Resources/snapshots/.gitkeep

# Generated static dump (Examples/Showcase build artifact)
Examples/Showcase/static-dump/

# Synced template runtime artifacts (regenerated by `make sync-templates`)
Sources/SwiftWUICLI/Templates/showcase/Tests/node_modules/
Sources/SwiftWUICLI/Templates/showcase/Tests/test-results/
Sources/SwiftWUICLI/Templates/showcase/Tests/playwright-report/
Sources/SwiftWUICLI/Templates/showcase/Tests/blob-report/
Sources/SwiftWUICLI/Templates/showcase/static-dump/

# Vendored wasi-shim resource (tracked despite blanket vendor/ rule above)
!Sources/SwiftWUIToolchain/Resources/vendor/
!Sources/SwiftWUIToolchain/Resources/vendor/**

# Design notes / specs — kept local, not tracked
docs/
